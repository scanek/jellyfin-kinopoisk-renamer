# Kinopoisk Unofficial API Key (from https://kinopoiskapiunofficial.tech/)
KINOPOISK_API_KEY=YOUR_KINOPOISK_API_KEY_HERE

# Jellyfin Connection
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=YOUR_JELLYFIN_API_KEY_HERE

# File & Folder Permissions (Optional)
PUID=1000
PGID=1000

# Action: move (default), hardlink, or copy
ACTION=move

# Rename parent release folder (true/false)
RENAME_FOLDERS=true
